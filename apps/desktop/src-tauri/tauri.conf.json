{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deckpress",
  "version": "0.1.0",
  "identifier": "dev.kerbaras.deckpress",
  "build": {
    "beforeDevCommand": "pnpm --filter @deckpress/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @deckpress/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Deckpress",
        "width": 1440,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: dpimg: http://dpimg.localhost; connect-src ipc: http://ipc.localhost dpimg: http://dpimg.localhost; font-src 'self' data:",
      "assetProtocol": { "enable": false }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/models/models.json": "resources/models/models.json",
      "resources/models/README.md": "resources/models/README.md",
      "resources/models/realesr-general-x4v3-dn50-256.fp16.onnx": "resources/models/realesr-general-x4v3-dn50-256.fp16.onnx",
      "resources/models/realesr-animevideov3-256.fp16.onnx": "resources/models/realesr-animevideov3-256.fp16.onnx"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
